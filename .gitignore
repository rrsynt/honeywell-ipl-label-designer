# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Golden-file diff artifacts (regenerated on failure)
testdata/golden/diffs/

# Crosscheck artifacts (regenerated by npm run crosscheck)
*.crosscheck.zpl
*.crosscheck.png

# WHATWG Encoding index files, fetched on demand by tools/gen-cjk-codepages.mjs.
# Upstream artifacts, not ours: the generated tables they produce ARE committed.
.tmp-whatwg/

# Shared library server data (tools/library-server.mjs). Designs saved here are
# the shop's, not the repository's.
library-data/

# Shared print server data (tools/print-server.mjs). The queue, the printer
# list and the log are the shop's, not the repository's.
print-data/

# Database server data (tools/db-server.mjs). The stored queries carry the
# connection strings, so this MUST never be committed.
db-data/

.vercel
